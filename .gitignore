# Do not add ExternalData module staging files
.ExternalData*

# Exclude compiled Python objects.
*.pyc
*.pyo
__pycache__/

# Exclude OS X .DS_Store files.
.DS_Store

# Exclude some Xcode stuff.
xcuserdata
project.xcworkspace

# Exclude VSCode settings and configuration folder.
*.vscode*

# Exclude Visual Studio stuff.
.vs*
CMakeSettings.json

# Exclude clangd cache.
.cache
.clangd

# Exclude user build directories.
out/
build/

# Exclude compile_commands.json optionally generated by cmake.
compile_commands.json

# Python
venv/
.venv/
wheelbuild/
wheelhouse/
__pycache__
*.whl

*.h264
