#ifndef vtkstreaming_libvpx_h
#define vtkstreaming_libvpx_h

/* Use the libvpx library configured for VTK.  */
#cmakedefine01 VTK_MODULE_USE_EXTERNAL_vtkstreaminglibvpx

/* Macro to help include a header file from the libvpx configured for
   VTK.
   #include "vtkstreaming_libvpx.h"
   #include VTKSTREAMINGLIBVPX_HEADER(vpx_codec.h)
*/
#if VTK_MODULE_USE_EXTERNAL_vtkstreaminglibvpx
#define VTKSTREAMINGLIBVPX_HEADER(x)  <vpx/x>
#else
#define VTKSTREAMINGLIBVPX_HEADER(x)  <vtkstreaminglibvpx/vpx/x>
#endif

#endif
